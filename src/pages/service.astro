---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CTA from '../components/CTA.astro';

const services = [
	{
		number: '01',
		label: 'Web Site',
		title: 'Webサイト制作',
		text: '企業や店舗の魅力がきちんと伝わるWebサイトを、企画・デザイン・コーディングまで一貫して制作します。',
	},
	{
		number: '02',
		label: 'Landing Page',
		title: 'LP制作',
		text: '商品やサービスの特徴を整理し、問い合わせや申し込みにつながるランディングページを制作します。',
	},
	{
		number: '03',
		label: 'WordPress / CMS',
		title: 'CMS構築',
		text: 'お知らせやブログ、実績などを、自社で無理なく更新できるWebサイトを構築します。',
	},
	{
		number: '04',
		label: 'Support',
		title: '運用・改善',
		text: '公開して終わりではなく、更新・修正・改善など、公開後のWeb運用も継続してサポートします。',
	},
];

const values = [
	{
		number: '01',
		title: '課題から考える',
		text: '「どんなサイトをつくるか」より先に、「何を解決したいのか」を考えます。',
	},
	{
		number: '02',
		title: '魅力を整理する',
		text: 'お客様自身では気づきにくい強みや魅力を整理し、言葉とデザインに落とし込みます。',
	},
	{
		number: '03',
		title: '成果につなげる',
		text: '見た目だけではなく、問い合わせや採用、認知など、本来の目的につながる設計を行います。',
	},
];

const scope = [
	'企画・ヒアリング',
	'情報設計',
	'Webデザイン',
	'コーディング',
	'WordPress / CMS',
	'スマートフォン対応',
	'SEO内部対策',
	'アクセス解析',
	'ドメイン・サーバー設定',
	'公開後の更新・保守',
];

const process = [
	{ number: '01', label: 'Contact', title: 'お問い合わせ' },
	{ number: '02', label: 'Hearing', title: 'ヒアリング・課題整理' },
	{ number: '03', label: 'Planning', title: '企画・構成' },
	{ number: '04', label: 'Design', title: 'デザイン' },
	{ number: '05', label: 'Development', title: 'コーディング・CMS構築' },
	{ number: '06', label: 'Launch', title: '確認・公開' },
	{ number: '07', label: 'Support', title: '運用・改善' },
];

const faqs = [
	{
		question: 'Webサイトについて詳しくなくても大丈夫ですか？',
		answer: 'はい。目的や現在のお悩みを伺いながら、必要なことを一緒に整理していきます。専門用語をできるだけ使わず、一つずつご説明します。',
	},
	{
		question: '原稿や写真がなくても依頼できますか？',
		answer: 'はい。ヒアリングをもとに、掲載する情報や原稿の方向性を整理します。写真撮影や素材選びについても、必要に応じてご相談いただけます。',
	},
	{
		question: 'WordPressにも対応していますか？',
		answer: 'はい。WordPressのほか、microCMS、Astro、Next.jsなどに対応しています。更新頻度や運用体制、ご予算に合わせて最適な方法をご提案します。',
	},
	{
		question: '公開後の更新もお願いできますか？',
		answer: 'はい。文章や画像の差し替え、ページ追加、保守、アクセス解析をもとにした改善など、公開後の運用もサポートしています。',
	},
	{
		question: '広島県外でも依頼できますか？',
		answer: 'はい。広島・尾道を拠点にしていますが、オンラインで全国からご依頼いただけます。打ち合わせ方法も柔軟に調整します。',
	},
];
---

<Layout
	title="Service｜BuildLab"
	description="Webサイト制作、LP制作、WordPress・CMS構築、公開後の運用改善まで。BuildLabが課題整理から一貫してサポートします。"
>
	<Header theme="light" />

	<main class="overflow-hidden bg-white text-[#102231]">
		<section data-hero-section class="relative flex items-center overflow-hidden bg-[#fafafa] px-6 py-16 sm:min-h-[540px] sm:px-10 lg:px-16">
			<svg
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 h-full w-full opacity-55 sm:opacity-80"
				viewBox="0 0 2048 610"
				preserveAspectRatio="none"
			>
				<path d="M980 610C1200 519 1263 405 1435 342C1650 263 1796 165 1974 0H2048V610H980Z" fill="#eef3f1"></path>
				<path d="M1210 610C1372 531 1486 446 1620 384C1810 296 1924 205 2048 104V610H1210Z" fill="#dce8e5" fill-opacity="0.72"></path>
				<path d="M1508 610C1674 535 1803 459 1911 392C1969 356 2014 322 2048 294V610H1508Z" fill="#c4d9d6" fill-opacity="0.78"></path>
				<path d="M1840 610C1920 574 1990 532 2048 489V610H1840Z" fill="#a9c8c5" fill-opacity="0.58"></path>
			</svg>

			<div class="relative z-10 mx-auto w-full max-w-6xl">
				<SectionTitle
					variant="page"
					as="h1"
					eyebrow="Service"
					subtitle={'Webサイトをつくることが、ゴールではありません。\nBuildLabは、課題を整理し、デザインと技術を通して、\nビジネスの成長につながるWebサイトをつくります。'}
				>
					Webの力で、<br />ビジネスを前へ。
				</SectionTitle>
			</div>
		</section>

		<section class="relative px-6 py-20 sm:px-10 sm:py-24 lg:px-16 lg:py-32">
			<div class="pointer-events-none absolute left-[-8rem] top-48 h-80 w-80 rounded-full bg-[#e9f4ff] blur-3xl"></div>
			<div class="relative mx-auto w-full max-w-6xl">
				<SectionTitle variant="values" eyebrow="Our Service">
					できること。
				</SectionTitle>
				<p class="mt-7 max-w-2xl text-sm font-medium leading-8 tracking-[0.035em] text-[#687174] sm:text-base">
					目的や運用方法に合わせて、企画から公開後まで。必要なものを選び、ひとつながりで支えます。
				</p>

				<div class="mt-14 grid gap-6 md:grid-cols-2 md:gap-7">
					{services.map((service) => (
						<article class="group flex min-h-[300px] flex-col rounded-[18px] border border-[#ccd5d5] bg-white p-8 shadow-[0_10px_22px_rgb(44_62_62_/_0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_rgb(44_62_62_/_0.12)] sm:p-10 lg:p-11">
							<div class="flex items-start justify-between gap-5 border-b border-accent pb-7">
								<p class="font-sans text-2xl font-light italic text-[#168bff]">{service.number}</p>
								<p class="pt-1 text-right font-sans text-xs font-medium uppercase text-[#9ab8b5] sm:text-sm">{service.label}</p>
							</div>
							<h3 class="mt-8 text-2xl font-black tracking-[0.02em] text-[#202526]">{service.title}</h3>
							<p class="mt-6 text-sm font-medium leading-8 tracking-[0.025em] text-[#687174] sm:text-base">{service.text}</p>
						</article>
					))}
				</div>

				<div class="mt-10 flex flex-col gap-5 rounded-[16px] bg-[#102231] opacity-95 px-7 py-4 text-white sm:flex-row sm:items-center sm:justify-between sm:px-9">
					<p class="text-sm font-bold leading-7 tracking-[0.025rem] sm:text-base">目的や更新体制に合わせて、最適な技術を選びます。</p>
				</div>
			</div>
		</section>

		<section class="bg-[#f7f8f7] px-6 py-20 sm:px-10 sm:py-24 lg:px-16 lg:py-32">
			<div class="mx-auto w-full max-w-6xl">
				<div class="border-l-2 border-main py-1 pl-7 sm:pl-8">
					<SectionTitle variant="approach" eyebrow="What We Value">
						ただつくるだけではなく、<br />「伝わる」まで考える。
					</SectionTitle>
				</div>

				<div class="mt-16 grid gap-10 lg:grid-cols-3 lg:gap-12">
					{values.map((value) => (
						<article class="border-t border-accent pt-8">
							<p class="font-sans font-medium tracking-[0.18em] text-main">{value.number}</p>
							<h3 class="mt-8 text-xl font-black tracking-[0.02em] text-[#202526] sm:text-2xl">{value.title}</h3>
							<p class="mt-5 text-sm font-medium leading-8 tracking-[0.025em] text-[#687174]">{value.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="px-6 py-20 sm:px-10 sm:py-24 lg:px-16 lg:py-32">
			<div class="mx-auto w-full max-w-6xl">
				<SectionTitle variant="values" eyebrow="Scope">
					Web制作に必要なことを、<br />まとめてサポート。
				</SectionTitle>

				<ol class="mt-14 grid border-l border-t border-[#d8e1e1] sm:grid-cols-2 lg:grid-cols-5">
					{scope.map((item, index) => (
						<li class="group min-h-36 border-b border-r border-[#d8e1e1] bg-white p-6 transition duration-300 hover:bg-[#f2f7f6] sm:min-h-40 sm:p-7">
							<span class="font-sans text-xs font-medium tracking-[0.16em] text-[#9ab8b5]">{String(index + 1).padStart(2, '0')}</span>
							<p class="mt-8 text-sm font-black leading-7 tracking-[0.02em] text-[#202526] sm:text-base">{item}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="bg-[#edf3f1] px-6 py-20 sm:px-10 sm:py-24 lg:px-16 lg:py-32">
			<div class="mx-auto w-full max-w-6xl">
				<SectionTitle variant="values" eyebrow="Process">
					はじめてのWeb制作でも、<br />一つずつ進めます。
				</SectionTitle>
				<p class="mt-7 max-w-2xl text-sm font-medium leading-8 tracking-[0.035em] text-[#687174] sm:text-base">
					わからないことがあっても大丈夫です。各段階で確認を重ねながら、目的に合ったサイトを一緒につくります。
				</p>

				<ol class="relative mt-16 grid gap-x-10 gap-y-0 md:grid-cols-2">
					{process.map((item) => (
						<li class="grid grid-cols-[3rem_1fr] gap-5 border-t border-[#b9cbc8] py-7 sm:grid-cols-[4rem_1fr] sm:gap-7 sm:py-8">
							<span class="font-sans text-sm font-medium tracking-[0.14em] text-main">{item.number}</span>
							<div>
								<p class="font-sans text-xs font-medium uppercase tracking-[0.16em] text-[#78918d]">{item.label}</p>
								<h3 class="mt-3 text-base font-black tracking-[0.02em] text-[#202526] sm:text-lg">{item.title}</h3>
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="px-6 py-20 sm:px-10 sm:py-24 lg:px-16 lg:py-32">
			<div class="mx-auto w-full max-w-5xl">
				<SectionTitle variant="contentCentered" eyebrow="FAQ">
					よくある質問
				</SectionTitle>

				<div class="mt-14 border-t-2 border-[#102231]">
					{faqs.map((faq, index) => (
						<details class="faq-item group border-b border-[#d8e1e1]">
							<summary class="flex cursor-pointer list-none items-start gap-4 py-7 pr-2 sm:gap-7 sm:py-8">
								<span class="font-sans text-lg font-medium italic text-main">Q.</span>
								<span class="flex-1 pt-0.5 text-sm font-black leading-7 tracking-[0.02em] text-[#202526] sm:text-base">{faq.question}</span>
								<span aria-hidden="true" class="faq-icon relative mt-1 h-5 w-5 shrink-0"></span>
							</summary>
							<div class="grid grid-cols-[2.25rem_1fr] gap-4 pb-8 sm:grid-cols-[3rem_1fr] sm:gap-7 sm:pb-9">
								<span class="font-sans text-lg font-medium italic text-[#9ab8b5]">A.</span>
								<p class="text-sm font-medium leading-8 tracking-[0.025em] text-[#687174] sm:text-base">{faq.answer}</p>
							</div>
						</details>
					))}
				</div>
			</div>
		</section>

		<CTA
			eyebrow="Contact"
			title="Webの悩みを、一緒に整理しませんか。"
			description="新規制作、リニューアル、運用のこと。まだ要件が決まっていない段階でも、お気軽にご相談ください。"
		/>
	</main>

	<Footer />
</Layout>

<style>
	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-icon::before,
	.faq-icon::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 18px;
		height: 1px;
		content: '';
		background: #168bff;
		transform: translate(-50%, -50%);
		transition: transform 0.25s ease;
	}

	.faq-icon::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.faq-item[open] .faq-icon::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}
</style>
