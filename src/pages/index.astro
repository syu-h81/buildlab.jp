---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import 'swiper/css';
import 'swiper/css/effect-fade';
import heroImage01 from '../assets/images/hero-image-01.webp';
import heroImage02 from '../assets/images/hero-image-02.webp';
import heroImage03 from '../assets/images/hero-image-03.webp';

const services = [
	{
		step: 'Step 1',
		title: 'Research & Strategy',
		subtitle: '調査・分析・戦略設計',
		text: '事業とユーザーを理解し、サイトが担う役割と情報設計を明確にします。',
		color: 'bg-[#082b3d]',
	},
	{
		step: 'Step 2',
		title: 'Design & Development',
		subtitle: 'デザイン・サイト制作',
		text: 'ブランドらしさを形にし、スマートフォンでも快適に使えるサイトを制作します。',
		color: 'bg-[#51b99b]',
	},
	{
		step: 'Step 3',
		title: 'Growth & Support',
		subtitle: '公開・改善・運用支援',
		text: '公開後の更新や改善まで、事業の成長に合わせて継続的にサポートします。',
		color: 'bg-[#ff8b1f]',
	},
];

const works = [
	{
		image: '/m-holdings.png',
		title: 'M Holdings様｜コーポレートサイト',
		category: 'コーポレートサイト / 企業サイト / Web制作',
		area: '広島県 / 尾道市',
	},
	{
		image: '/AQ-RESIDENCE.png',
		title: 'AQ RESIDENCE様｜ブランドサイト',
		category: '住宅 / 不動産 / ブランドサイト',
		area: '広島県 / 福山市',
	},
	{
		image: '/kokoshiro.png',
		title: 'ここしろ様｜サービスサイト',
		category: '福祉 / 地域サービス / Web制作',
		area: '広島県 / 尾道市',
	},
	{
		image: '/hirock-lab.png',
		title: 'HIROCK LAB様｜メディアサイト',
		category: '研究 / 教育 / 情報発信サイト',
		area: '広島県',
	},
	{
		image: '/smile_sumai.png',
		title: 'スマイル住まい様｜サービスサイト',
		category: '住宅 / リフォーム / 集客サイト',
		area: '岡山県',
	},
	{
		image: '/primekaji.png',
		title: 'プライム家事様｜サービスサイト',
		category: '暮らし / 家事代行 / サービスサイト',
		area: '関西地方',
	},
	{
		image: '/pivotta.png',
		title: 'Pivotta様｜プロダクトサイト',
		category: 'SaaS / ITサービス / LP制作',
		area: '東京都',
	},
	{
		image: '/SoLaNi-ENERGIE.png',
		title: 'SoLaNi ENERGIE様｜コーポレートサイト',
		category: 'エネルギー / 企業サイト / Web制作',
		area: '広島県',
	},
	{
		image: '/SmartES.png',
		title: 'SmartES様｜サービスサイト',
		category: 'DX / 業務支援 / サービスサイト',
		area: '東京都',
	},
];

const plans = [
	{
		name: 'Light',
		price: '¥220,000〜',
		text: '必要な情報をコンパクトにまとめる、スモールスタート向けプラン。',
	},
	{
		name: 'Standard',
		price: '¥440,000〜',
		text: '設計・デザイン・実装を一貫して行う、企業サイト向けの基本プラン。',
	},
	{
		name: 'Custom',
		price: 'お見積もり',
		text: '採用、EC、多言語など、目的や機能に合わせて個別に設計します。',
	},
];
---

<Layout>
	<Header />

	<main class="overflow-hidden bg-white text-[#092c3c]">
		<section data-hero-section class="relative min-h-[100svh] overflow-hidden bg-[#37575b]">
			<div class="absolute inset-0 z-0">
				<div class="hero-slider swiper h-full w-full">
					<div class="swiper-wrapper h-full">
						<div class="swiper-slide h-full">
							<img
								src={heroImage01.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
						<div class="swiper-slide h-full">
							<img
								src={heroImage02.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
						<div class="swiper-slide h-full">
							<img
								src={heroImage03.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="absolute inset-0 z-10 bg-black/45 text-justify"></div>
			<div class="relative z-20 mx-auto flex min-h-[100svh] max-w-[1600px] flex-col items-start justify-center px-6 py-24 text-left sm:px-10 lg:px-16">
				<h1 class="max-w-6xl text-[clamp(3.5rem,8vw,8.5rem)] font-black leading-[1.08] text-white">
					Local Business.<br>
					Digital Growth.
				</h1>
				<div class="mt-9 flex flex-col items-start gap-5 text-white">
					<p class="max-w-xl leading-7 tracking-[0.1rem] font-bold text-lg">
						地域企業の魅力を、デザインと技術で未来へ届けます。
					</p>
				</div>
			</div>
		</section>

		<section id="about" class="relative overflow-hidden bg-[#fbfcfe] px-6 py-24 text-center text-[#253044] sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="pointer-events-none absolute left-[8%] top-28 h-44 w-44 rounded-full bg-[#eaf3ff]/70 blur-3xl"></div>
			<div class="mx-auto max-w-[1480px]">
				<p class="text-sm font-black uppercase tracking-[0.24em] text-[#9aa4b2]">About</p>
				<h2 class="mt-6 text-[clamp(2.1rem,4.8vw,4rem)] font-black leading-tight tracking-normal text-[#1f2a3d]">
					地域に寄り添い、未来を築く。
				</h2>

				<div class="mx-auto mt-20 max-w-5xl rounded-[28px] border border-[#eef2f7] bg-white px-6 py-12 shadow-[0_22px_48px_rgb(15_23_42_/_0.14)] sm:px-12 sm:py-14 lg:px-20">
					<div class="space-y-8 text-base font-bold leading-[2] tracking-[0.03em] text-[#6b7280] sm:text-lg">
						<p>
							私たちは、地域に根ざした企業だからこそ持つ価値があると信じています。
						</p>
						<p>
							その価値を、正しく伝え、<br />
							選ばれる理由へ変えていくこと。<br />
							それが私たちの仕事です。
						</p>
						<div class="mx-auto h-1 w-16 bg-[#3b82f6]"></div>
						<p>
							美しいデザインだけでは終わらず、<br />
							伝わる構成、迷わない導線、育て続けられる仕組みまで設計することで、<br />
							ホームページを「成果につながる資産」へ育てます。
						</p>
					</div>
				</div>

				<div class="mt-24 grid gap-8 lg:grid-cols-3">
					<article class="rounded-[22px] border border-[#eef2f7] bg-white px-8 py-12 shadow-[0_18px_38px_rgb(15_23_42_/_0.12)]">
						<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#eaf1ff] text-[#3b82f6]">
							<svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="m5 5 8 7-8 7V5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
								<path d="m13 5 8 7-8 7V5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
							</svg>
						</div>
						<h3 class="mt-8 text-2xl font-black text-[#253044]">高速表示</h3>
						<p class="mt-5 text-base font-bold leading-8 text-[#8a94a3]">
							最新技術による超高速表示で、ユーザー体験を向上
						</p>
					</article>

					<article class="rounded-[22px] border border-[#eef2f7] bg-white px-8 py-12 shadow-[0_18px_38px_rgb(15_23_42_/_0.12)]">
						<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#eaf1ff] text-[#3b82f6]">
							<svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
								<path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
							</svg>
						</div>
						<h3 class="mt-8 text-2xl font-black text-[#253044]">SEO 対策</h3>
						<p class="mt-5 text-base font-bold leading-8 text-[#8a94a3]">
							検索エンジンに強い構造設計で、確実に見つけてもらえるサイトへ
						</p>
					</article>

					<article class="rounded-[22px] border border-[#eef2f7] bg-white px-8 py-12 shadow-[0_18px_38px_rgb(15_23_42_/_0.12)]">
						<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#eaf1ff] text-[#3b82f6]">
							<svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M20.4 5.9a5.1 5.1 0 0 0-7.2 0L12 7.1l-1.2-1.2a5.1 5.1 0 0 0-7.2 7.2L12 21l8.4-7.9a5.1 5.1 0 0 0 0-7.2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
							</svg>
						</div>
						<h3 class="mt-8 text-2xl font-black text-[#253044]">地域密着</h3>
						<p class="mt-5 text-base font-bold leading-8 text-[#8a94a3]">
							広島・尾道を拠点に、地域企業のデジタル化を全力サポート
						</p>
					</article>
				</div>

				<div class="mt-20 rounded-[28px] bg-[#253044] px-6 py-14 text-white shadow-[0_22px_48px_rgb(15_23_42_/_0.18)] sm:px-10 lg:py-16">
					<h3 class="text-3xl font-black">BuildLab は、</h3>
					<p class="mt-7 text-lg font-bold leading-8 text-white/82">
						地域企業の未来をデザインと技術で支える制作スタジオです。
					</p>
					<a
						href="#service"
						class="mt-10 inline-flex min-h-14 min-w-52 items-center justify-center rounded-lg bg-white px-8 text-base font-black text-[#253044] transition duration-300 hover:bg-[#3b82f6] hover:text-white"
					>
						私たちについて
					</a>
				</div>
			</div>
		</section>

		<section id="service" class="relative rounded-t-[28px] bg-white px-6 py-24 sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="mx-auto max-w-[1400px]">
				<div class="mx-auto max-w-4xl text-center">
					<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]">Services</p>
					<h2 class="mt-6 text-4xl font-black leading-[0.95] sm:text-6xl lg:text-7xl">
						We design websites<br />
						<span class="text-[#1c806f]">that move business.</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl leading-8 text-[#58717b]">
						戦略からデザイン、実装、公開後の改善まで。目的に合わせた一貫したWeb制作をご提供します。
					</p>
				</div>

				<div class="relative mx-auto mt-20 max-w-4xl">
					<div class="absolute bottom-12 left-8 top-12 hidden w-px bg-[#cbdcd8] sm:block"></div>
					<div class="space-y-10">
						{services.map((service) => (
							<article class="relative grid gap-6 border-b border-[#dce7e4] pb-10 sm:grid-cols-[70px_1fr]">
								<div class={`relative z-10 flex h-16 w-16 items-center justify-center rounded-full ${service.color} text-xl font-black text-white`}>
									{service.step.replace('Step ', '')}
								</div>
								<div class="grid gap-5 md:grid-cols-[1fr_1.2fr] md:items-start">
									<div>
										<p class="text-sm font-bold text-[#42a98c]">{service.step}</p>
										<h3 class="mt-2 text-2xl font-black leading-7">{service.title}</h3>
										<p class="mt-2 font-bold">{service.subtitle}</p>
									</div>
									<p class="leading-8 text-[#58717b]">{service.text}</p>
								</div>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section id="works" class="relative overflow-hidden bg-white px-6 py-24 text-[#111111] sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="pointer-events-none absolute inset-x-0 top-[35%] mx-auto h-[520px] max-w-[1100px] bg-[linear-gradient(120deg,transparent_18%,#eef8fb_18%,#eef8fb_28%,transparent_28%,transparent_43%,#eef8fb_43%,#eef8fb_55%,transparent_55%)] opacity-55"></div>
			<div class="relative mx-auto max-w-[1500px]">
				<div class="text-center">
					<h2 class="text-[clamp(4rem,8vw,7.5rem)] font-normal leading-none tracking-normal text-[#102231]">
						Works
					</h2>
					<p class="mt-8 text-xl font-black tracking-[0.08em] text-[#111111]">
						Webサイト制作実績
					</p>
					<p class="mx-auto mt-24 max-w-3xl text-xl font-black leading-[2] tracking-[0.08em] text-[#111111]">
						BuildLabでは、オリジナリティの高いデザインだけでなく、<br class="hidden sm:block" />
						競合他社を踏まえたコンセプト設計やSEO対策も考慮した、<br class="hidden sm:block" />
						<span class="text-[#ff3b3b]">「総合力の高いWebサイト」</span>をお作りしています。
					</p>
				</div>

				<div class="mt-24 grid gap-x-10 gap-y-20 sm:grid-cols-2 lg:grid-cols-3">
					{works.map((work) => (
						<article>
							<img
								src={work.image}
								alt={work.title}
								class="aspect-[16/9] w-full object-cover shadow-[0_14px_34px_rgb(15_23_42_/_0.12)]"
								loading="lazy"
							/>
							<h3 class="mt-5 text-base font-black leading-7 text-[#111111]">
								{work.title}
							</h3>
							<p class="mt-4 text-sm font-bold leading-7 text-[#8a8f98]">
								{work.category}<br />
								{work.area}
							</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="price" class="bg-[#0d6668] px-6 py-24 text-white sm:px-10 sm:py-32 lg:px-16">
			<div class="mx-auto max-w-[1400px]">
				<div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#b9eadb]">Price</p>
						<h2 class="mt-5 text-5xl font-black sm:text-7xl">Simple plans,<br />clear value.</h2>
					</div>
					<p class="max-w-xl text-lg leading-8 text-white/75">
						サイトの目的や規模に合わせて選べる基本プランです。内容を伺ったうえで、最適な進め方とお見積もりをご提案します。
					</p>
				</div>

				<div class="mt-14 grid gap-px bg-white/25 lg:grid-cols-3">
					{plans.map((plan, index) => (
						<article class={`min-h-80 p-8 sm:p-10 ${index === 1 ? 'bg-[#ff922d]' : 'bg-[#0d6668]'}`}>
							<p class="text-sm font-bold uppercase tracking-[0.2em]">Plan {String(index + 1).padStart(2, '0')}</p>
							<h3 class="mt-8 text-3xl font-black">{plan.name}</h3>
							<p class="mt-4 text-2xl font-black">{plan.price}</p>
							<p class="mt-8 leading-8 text-white/80">{plan.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="relative rounded-t-[28px] bg-white px-6 py-24 sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="mx-auto max-w-[1500px]">
				<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]">Contact</p>
				<div class="mt-8 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
					<h2 class="text-[clamp(4rem,10vw,10rem)] font-black leading-[0.8]">
						Get <span class="text-[#1c806f]">in touch.</span>
					</h2>
					<a href="mailto:info@buildlab.jp" class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-[#ff922d] text-3xl text-white transition duration-300 hover:rotate-45 hover:bg-[#168bff] sm:h-28 sm:w-28">
						→
					</a>
				</div>
				<div class="mt-16 grid gap-5 border-t border-[#cbd9d6] pt-8 sm:grid-cols-2 sm:items-end">
					<p class="max-w-xl text-lg leading-8 text-[#58717b]">
						新規制作、リニューアル、運用のご相談など、まだ要件が固まっていない段階でもお気軽にお問い合わせください。
					</p>
					<a href="mailto:info@buildlab.jp" class="text-2xl font-black sm:text-right sm:text-3xl">info@buildlab.jp</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	import Swiper from 'swiper';
	import { Autoplay, EffectFade } from 'swiper/modules';

	new Swiper('.hero-slider', {
		modules: [Autoplay, EffectFade],
		loop: true,
		speed: 1800,
		effect: 'fade',
		fadeEffect: {
			crossFade: true,
		},
		allowTouchMove: false,
		autoplay: {
			delay: 4000,
			disableOnInteraction: false,
		},
	});
</script>
