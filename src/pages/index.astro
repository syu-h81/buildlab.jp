---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import 'swiper/css';
import 'swiper/css/effect-fade';
import heroImage01 from '../assets/images/hero-image-01.webp';
import heroImage02 from '../assets/images/hero-image-02.webp';
import heroImage03 from '../assets/images/hero-image-03.webp';

const problems = [
	{
		number: '01',
		title: '伝えたい価値が、うまく届かない',
		text: '情報を整理し、訪れた人が迷わず理解できるサイト構成を設計します。',
	},
	{
		number: '02',
		title: '更新しづらく、サイトが育たない',
		text: '運用しやすい仕組みを整え、公開後も活用し続けられるサイトを作ります。',
	},
	{
		number: '03',
		title: 'デザインと成果がつながらない',
		text: '見た目だけでなく、問い合わせや採用など目的につながる導線を考えます。',
	},
];

const services = [
	{
		step: 'Step 1',
		title: 'Research & Strategy',
		subtitle: '調査・分析・戦略設計',
		text: '事業とユーザーを理解し、サイトが担う役割と情報設計を明確にします。',
		color: 'bg-[#082b3d]',
	},
	{
		step: 'Step 2',
		title: 'Design & Development',
		subtitle: 'デザイン・サイト制作',
		text: 'ブランドらしさを形にし、スマートフォンでも快適に使えるサイトを制作します。',
		color: 'bg-[#51b99b]',
	},
	{
		step: 'Step 3',
		title: 'Growth & Support',
		subtitle: '公開・改善・運用支援',
		text: '公開後の更新や改善まで、事業の成長に合わせて継続的にサポートします。',
		color: 'bg-[#ff8b1f]',
	},
];

const works = [
	{ category: 'Corporate Website', title: '地域企業の魅力を伝えるコーポレートサイト' },
	{ category: 'Recruiting Website', title: '働く人の空気が見える採用サイト' },
	{ category: 'Service Website', title: 'サービスの価値を整理したプロモーションサイト' },
];

const plans = [
	{
		name: 'Light',
		price: '¥220,000〜',
		text: '必要な情報をコンパクトにまとめる、スモールスタート向けプラン。',
	},
	{
		name: 'Standard',
		price: '¥440,000〜',
		text: '設計・デザイン・実装を一貫して行う、企業サイト向けの基本プラン。',
	},
	{
		name: 'Custom',
		price: 'お見積もり',
		text: '採用、EC、多言語など、目的や機能に合わせて個別に設計します。',
	},
];
---

<Layout>
	<Header />

	<main class="overflow-hidden bg-white text-[#092c3c]">
		<section data-hero-section class="relative min-h-[100svh] overflow-hidden bg-[#37575b]">
			<div class="absolute inset-0 z-0">
				<div class="hero-slider swiper h-full w-full">
					<div class="swiper-wrapper h-full">
						<div class="swiper-slide h-full">
							<img
								src={heroImage01.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
						<div class="swiper-slide h-full">
							<img
								src={heroImage02.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
						<div class="swiper-slide h-full">
							<img
								src={heroImage03.src}
								alt=""
								width={1920}
								height={1080}
								class="h-full w-full object-cover brightness-[0.72]"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="absolute inset-0 z-10 bg-black/45 text-justify"></div>
			<div class="relative z-20 mx-auto flex min-h-[100svh] max-w-[1600px] flex-col items-start justify-center px-6 py-24 text-left sm:px-10 lg:px-16">
				<h1 class="max-w-6xl text-[clamp(3.5rem,8vw,8.5rem)] font-black leading-[1.08] text-white">
					Local Business.<br>
					Digital Growth.
				</h1>
				<div class="mt-9 flex flex-col items-start gap-5 text-white">
					<p class="max-w-xl leading-7 tracking-[0.1rem] font-bold text-lg">
						地域企業の魅力を、デザインと技術で未来へ届けます。
					</p>
				</div>
			</div>
		</section>

		<section id="about" class="relative bg-[#13706f] px-6 py-24 text-white sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="absolute right-0 top-0 h-full w-[14%] bg-[#ff922d]"></div>
			<div class="relative mx-auto grid max-w-[1500px] gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
				<div>
					<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#b9eadb]">Problems</p>
					<h2 class="mt-6 text-4xl font-black leading-none sm:text-6xl lg:text-7xl">
						Your business<br />deserves clarity.
					</h2>
					<p class="mt-8 max-w-xl text-lg leading-8 text-white/80">
						Webサイトの課題は、見た目だけではありません。情報、導線、更新性をひとつずつ整理し、成果につながる形へ整えます。
					</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-3">
					{problems.map((problem) => (
						<article class="min-h-72 bg-white p-6 text-[#092c3c] shadow-xl sm:first:-rotate-2 sm:last:rotate-2">
							<p class="text-sm font-black text-[#ff8b1f]">{problem.number}</p>
							<h3 class="mt-12 text-xl font-black leading-7">{problem.title}</h3>
							<p class="mt-5 text-sm leading-7 text-[#49636e]">{problem.text}</p>
						</article>
					))}
				</div>
			</div>
			<p class="relative mx-auto mt-24 max-w-[1500px] whitespace-nowrap text-[clamp(2.5rem,6vw,7rem)] font-black leading-none text-white">
				Think local. Build forward.
			</p>
		</section>

		<section id="service" class="relative rounded-t-[28px] bg-white px-6 py-24 sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="mx-auto max-w-[1400px]">
				<div class="mx-auto max-w-4xl text-center">
					<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]">Services</p>
					<h2 class="mt-6 text-4xl font-black leading-[0.95] sm:text-6xl lg:text-7xl">
						We design websites<br />
						<span class="text-[#1c806f]">that move business.</span>
					</h2>
					<p class="mx-auto mt-8 max-w-2xl leading-8 text-[#58717b]">
						戦略からデザイン、実装、公開後の改善まで。目的に合わせた一貫したWeb制作をご提供します。
					</p>
				</div>

				<div class="relative mx-auto mt-20 max-w-4xl">
					<div class="absolute bottom-12 left-8 top-12 hidden w-px bg-[#cbdcd8] sm:block"></div>
					<div class="space-y-10">
						{services.map((service) => (
							<article class="relative grid gap-6 border-b border-[#dce7e4] pb-10 sm:grid-cols-[70px_1fr]">
								<div class={`relative z-10 flex h-16 w-16 items-center justify-center rounded-full ${service.color} text-xl font-black text-white`}>
									{service.step.replace('Step ', '')}
								</div>
								<div class="grid gap-5 md:grid-cols-[1fr_1.2fr] md:items-start">
									<div>
										<p class="text-sm font-bold text-[#42a98c]">{service.step}</p>
										<h3 class="mt-2 text-2xl font-black leading-7">{service.title}</h3>
										<p class="mt-2 font-bold">{service.subtitle}</p>
									</div>
									<p class="leading-8 text-[#58717b]">{service.text}</p>
								</div>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section id="works" class="bg-[#f2f5f3] px-6 py-24 sm:px-10 sm:py-32 lg:px-16">
			<div class="mx-auto max-w-[1400px]">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]">Works</p>
						<h2 class="mt-4 text-5xl font-black sm:text-7xl">Selected works.</h2>
					</div>
					<a href="#contact" class="inline-flex items-center gap-3 font-bold text-[#1c806f]">
						View all works <span>→</span>
					</a>
				</div>

				<div class="mt-14 grid gap-7 lg:grid-cols-3">
					{works.map((work, index) => (
						<article class={index === 1 ? 'lg:translate-y-10' : ''}>
							<div class="grid aspect-[4/3] place-items-center bg-[#ccd7d3] text-xs font-bold uppercase tracking-[0.2em] text-[#6f8580]">
								Work image placeholder
							</div>
							<p class="mt-6 text-xs font-bold uppercase tracking-[0.15em] text-[#42a98c]">{work.category}</p>
							<h3 class="mt-3 text-xl font-black leading-7">{work.title}</h3>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="price" class="bg-[#0d6668] px-6 py-24 text-white sm:px-10 sm:py-32 lg:px-16">
			<div class="mx-auto max-w-[1400px]">
				<div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#b9eadb]">Price</p>
						<h2 class="mt-5 text-5xl font-black sm:text-7xl">Simple plans,<br />clear value.</h2>
					</div>
					<p class="max-w-xl text-lg leading-8 text-white/75">
						サイトの目的や規模に合わせて選べる基本プランです。内容を伺ったうえで、最適な進め方とお見積もりをご提案します。
					</p>
				</div>

				<div class="mt-14 grid gap-px bg-white/25 lg:grid-cols-3">
					{plans.map((plan, index) => (
						<article class={`min-h-80 p-8 sm:p-10 ${index === 1 ? 'bg-[#ff922d]' : 'bg-[#0d6668]'}`}>
							<p class="text-sm font-bold uppercase tracking-[0.2em]">Plan {String(index + 1).padStart(2, '0')}</p>
							<h3 class="mt-8 text-3xl font-black">{plan.name}</h3>
							<p class="mt-4 text-2xl font-black">{plan.price}</p>
							<p class="mt-8 leading-8 text-white/80">{plan.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="relative rounded-t-[28px] bg-white px-6 py-24 sm:px-10 sm:py-32 lg:px-16 lg:py-40">
			<div class="mx-auto max-w-[1500px]">
				<p class="text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]">Contact</p>
				<div class="mt-8 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
					<h2 class="text-[clamp(4rem,10vw,10rem)] font-black leading-[0.8]">
						Get <span class="text-[#1c806f]">in touch.</span>
					</h2>
					<a href="mailto:info@buildlab.jp" class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-[#ff922d] text-3xl text-white transition duration-300 hover:rotate-45 hover:bg-[#168bff] sm:h-28 sm:w-28">
						→
					</a>
				</div>
				<div class="mt-16 grid gap-5 border-t border-[#cbd9d6] pt-8 sm:grid-cols-2 sm:items-end">
					<p class="max-w-xl text-lg leading-8 text-[#58717b]">
						新規制作、リニューアル、運用のご相談など、まだ要件が固まっていない段階でもお気軽にお問い合わせください。
					</p>
					<a href="mailto:info@buildlab.jp" class="text-2xl font-black sm:text-right sm:text-3xl">info@buildlab.jp</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	import Swiper from 'swiper';
	import { Autoplay, EffectFade } from 'swiper/modules';

	new Swiper('.hero-slider', {
		modules: [Autoplay, EffectFade],
		loop: true,
		speed: 1800,
		effect: 'fade',
		fadeEffect: {
			crossFade: true,
		},
		allowTouchMove: false,
		autoplay: {
			delay: 4000,
			disableOnInteraction: false,
		},
	});
</script>
