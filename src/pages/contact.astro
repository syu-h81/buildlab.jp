---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CTA from '../components/CTA.astro';

const contactDetails = [
	{ label: 'Email', value: 'info@buildlab.jp', href: 'mailto:info@buildlab.jp' },
	{ label: 'Location', value: '広島県尾道市' },
	{ label: 'Online', value: 'Zoom / Google Meet / 相談無料' },
];
---

<Layout
	title="Contact｜BuildLab"
	description="BuildLabへのお問い合わせページ。Webサイト制作やLP制作、改善の相談を承っています。"
>
	<Header theme="light" />

	<main class="overflow-hidden bg-white text-[#102231]">
		<section data-hero-section class="relative flex items-center overflow-hidden bg-[#fafafa] px-6 py-16 sm:min-h-[540px] sm:px-10 lg:px-16">
			<svg
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 h-full w-full opacity-55 sm:opacity-80"
				viewBox="0 0 2048 610"
				preserveAspectRatio="none"
			>
				<path d="M980 610C1200 519 1263 405 1435 342C1650 263 1796 165 1974 0H2048V610H980Z" fill="#eef3f1"></path>
				<path d="M1210 610C1372 531 1486 446 1620 384C1810 296 1924 205 2048 104V610H1210Z" fill="#dce8e5" fill-opacity="0.72"></path>
				<path d="M1508 610C1674 535 1803 459 1911 392C1969 356 2014 322 2048 294V610H1508Z" fill="#c4d9d6" fill-opacity="0.78"></path>
				<path d="M1840 610C1920 574 1990 532 2048 489V610H1840Z" fill="#a9c8c5" fill-opacity="0.58"></path>
			</svg>

			<div class="relative z-10 mx-auto w-full max-w-6xl">
				<SectionTitle
					variant="page"
					as="h1"
					eyebrow="Contact"
					subtitle={'Webサイトのこと、事業や集客のこと、今の悩みやご希望をお聞かせください。\n小さなご相談でも大丈夫です。BuildLabと一緒に、最適な形を考えます。'}
				>
					まずは、ご相談から。
				</SectionTitle>
			</div>
		</section>

		<section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
			<div class="mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[1.1fr_0.9fr]">
				<div class="rounded-[24px] border border-[#dfe7e5] bg-[#fafcfc] p-8 shadow-[0_10px_24px_rgb(44_62_62_/_0.04)] sm:p-10 lg:p-12">
					<SectionTitle variant="values" eyebrow="Inquiry">
						お問い合わせフォーム
					</SectionTitle>
					<p class="mt-7 max-w-xl text-sm font-medium leading-8 tracking-[0.035em] text-[#687174] sm:text-base">
						新規制作、リニューアル、運用のこと。まだ具体的な内容が決まっていない段階でも、まずはご相談ください。
					</p>

					<form class="mt-10 space-y-6" action="mailto:info@buildlab.jp" method="post" enctype="text/plain">
						<div>
							<label for="name" class="mb-2 block text-xs font-black uppercase tracking-[0.18em] text-[#6f7f89]">Name</label>
							<input id="name" name="name" type="text" placeholder="お名前" class="w-full rounded-[12px] border border-[#d9e3e1] bg-white px-4 py-3 text-sm text-[#102231] outline-none transition focus:border-[#168bff]" />
						</div>
						<div>
							<label for="email" class="mb-2 block text-xs font-black uppercase tracking-[0.18em] text-[#6f7f89]">Email</label>
							<input id="email" name="email" type="email" placeholder="example@example.com" class="w-full rounded-[12px] border border-[#d9e3e1] bg-white px-4 py-3 text-sm text-[#102231] outline-none transition focus:border-[#168bff]" />
						</div>
						<div>
							<label for="project" class="mb-2 block text-xs font-black uppercase tracking-[0.18em] text-[#6f7f89]">Project</label>
							<input id="project" name="project" type="text" placeholder="例：コーポレートサイト制作" class="w-full rounded-[12px] border border-[#d9e3e1] bg-white px-4 py-3 text-sm text-[#102231] outline-none transition focus:border-[#168bff]" />
						</div>
						<div>
							<label for="message" class="mb-2 block text-xs font-black uppercase tracking-[0.18em] text-[#6f7f89]">Message</label>
							<textarea id="message" name="message" rows="6" placeholder="ご要望や現在のお悩みをご記入ください。" class="w-full rounded-[12px] border border-[#d9e3e1] bg-white px-4 py-3 text-sm text-[#102231] outline-none transition focus:border-[#168bff]"></textarea>
						</div>
						<button type="submit" class="inline-flex min-h-14 items-center justify-center rounded-full bg-[#168bff] px-8 text-sm font-black tracking-[0.08em] text-white transition duration-300 hover:bg-[#102231]">
							Send inquiry
						</button>
					</form>
				</div>

				<aside class="rounded-[24px] border border-[#dfe7e5] bg-white p-8 shadow-[0_10px_24px_rgb(44_62_62_/_0.04)] sm:p-10">
					<SectionTitle variant="message" eyebrow="Contact info">
						ご連絡先
					</SectionTitle>

					<div class="mt-10 space-y-8">
						{contactDetails.map((item) => (
							<div class="border-b border-[#e7eeed] pb-5 last:border-b-0 last:pb-0">
								<p class="text-[10px] font-black uppercase tracking-[0.2em] text-[#9ab8b5]">{item.label}</p>
								{item.href ? (
									<a href={item.href} class="mt-3 block text-lg font-black tracking-[0.02em] text-[#202526] transition hover:text-[#168bff]">
										{item.value}
									</a>
								) : (
									<p class="mt-3 text-lg font-black tracking-[0.02em] text-[#202526]">{item.value}</p>
								)}
							</div>
						))}
					</div>

					<div class="mt-10 rounded-[16px] bg-[#102231] p-6 text-white">
						<p class="text-xs font-black uppercase tracking-[0.18em] text-[#9ab8b5]">Support</p>
						<p class="mt-4 text-sm font-medium leading-8 tracking-[0.03em] text-white/80">
							相談無料。オンライン対応可能です。<br />
							まずは気軽にご連絡ください。
						</p>
					</div>
				</aside>
			</div>
		</section>

		<CTA
			eyebrow="Start a project."
			title="Webの悩みを、まずは一緒に整理しませんか。"
			description="まだイメージが固まっていなくても大丈夫です。ご相談の第一歩として、気軽にお聞かせください。"
			href="mailto:info@buildlab.jp"
			label="相談してみる"
		/>
	</main>

	<Footer />
</Layout>
