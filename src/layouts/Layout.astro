---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'BuildLab｜地域企業のためのWeb制作スタジオ',
	description = '広島・尾道を拠点に、地域企業の魅力をデザインと技術で未来へ届けるWeb制作スタジオです。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="font-[family-name:var(--font-hiphop)]">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
