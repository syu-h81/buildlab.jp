---
type Variant =
	| 'about'
	| 'services'
	| 'works'
	| 'price'
	| 'contact'
	| 'page'
	| 'content'
	| 'message'
	| 'values'
	| 'contentCentered'
	| 'approach'
	| 'ctaLight';

interface Props {
	variant: Variant;
	eyebrow?: string;
	subtitle?: string;
	as?: 'h1' | 'h2';
}

const { variant, eyebrow, subtitle, as = 'h2' } = Astro.props as Props;
const Heading = as;

const styles: Record<
	Variant,
	{
		container: string;
		eyebrow: string;
		title: string;
		subtitle?: string;
		headingRow?: string;
	}
> = {
	about: {
		container: '',
		eyebrow: 'text-sm font-black uppercase tracking-[0.24em] text-[#9aa4b2]',
		title: 'mt-6 text-[clamp(2.1rem,4.8vw,3rem)] font-black leading-tight tracking-normal text-[#1f2a3d]',
		subtitle: '',
	},
	services: {
		container: 'mx-auto max-w-4xl text-center',
		eyebrow: 'text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]',
		title: 'mt-6 text-4xl font-black leading-[0.95] sm:text-6xl lg:text-7xl',
		subtitle: '',
	},
	works: {
		container: 'text-center',
		eyebrow: '',
		title: 'text-[clamp(4rem,8vw,7.5rem)] font-normal leading-none tracking-normal text-[#102231]',
		subtitle: 'mt-8 text-xl font-black tracking-[0.08em] text-[#111111]',
	},
	price: {
		container: '',
		eyebrow: 'text-sm font-bold uppercase tracking-[0.24em] text-[#b9eadb]',
		title: 'mt-5 text-5xl font-black sm:text-7xl',
		subtitle: '',
	},
	contact: {
		container: '',
		eyebrow: 'text-sm font-bold uppercase tracking-[0.24em] text-[#42a98c]',
		title: 'text-[clamp(4rem,10vw,10rem)] font-black leading-[0.8]',
		subtitle: '',
		headingRow: 'mt-8 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between',
	},
	page: {
		container: '',
		eyebrow: 'text-sm font-medium tracking-[0.22em] text-[#9ab8b5] sm:text-base',
		title: 'mt-5 max-w-4xl font-sans text-[clamp(3rem,5vw,4.25rem)] font-light italic leading-[1.05] tracking-[-0.035em] text-[#111111]',
		subtitle: 'mt-9 max-w-3xl whitespace-pre-line text-sm font-medium leading-8 tracking-[0.04em] text-[#687174] sm:text-base sm:leading-9',
	},
	content: {
		container: '',
		eyebrow: 'text-sm font-black uppercase tracking-[0.24em] text-[#168bff]',
		title: 'mt-5 text-[clamp(2.4rem,5vw,4.75rem)] font-black leading-[1.08] tracking-[-0.025em] text-[#102231]',
		subtitle: 'mt-6 max-w-2xl text-base font-bold leading-8 text-[#6f7f89]',
	},
	message: {
		container: '',
		eyebrow: 'font-sans text-base font-medium italic tracking-[0.14em] text-[#9ab8b5] sm:text-lg',
		title: 'mt-4 text-[clamp(2.25rem,4vw,3.25rem)] font-black leading-tight tracking-[-0.025em] text-[#111111]',
		subtitle: '',
	},
	values: {
		container: '',
		eyebrow: 'font-sans text-base font-medium italic tracking-[0.14em] text-[#9ab8b5] sm:text-lg',
		title: 'mt-4 text-[clamp(2.25rem,4vw,3.25rem)] font-black leading-tight tracking-[-0.025em] text-[#111111]',
		subtitle: '',
	},
	contentCentered: {
		container: 'mx-auto max-w-5xl text-center',
		eyebrow: 'text-sm font-black uppercase tracking-[0.24em] text-[#168bff]',
		title: 'mt-5 text-[clamp(2.4rem,5vw,3rem)] font-black leading-[1.08] tracking-[-0.025em] text-[#102231]',
		subtitle: 'mx-auto mt-6 max-w-2xl text-base font-bold leading-8 text-[#6f7f89]',
	},
	approach: {
		container: '',
		eyebrow: 'font-sans text-base font-medium italic tracking-[0.14em] text-[#9ab8b5] sm:text-lg',
		title: 'mt-4 text-[clamp(2.25rem,4vw,3.25rem)] font-black leading-tight tracking-[-0.025em] text-[#111111]',
		subtitle: '',
	},
	ctaLight: {
		container: 'mx-auto max-w-4xl text-center',
		eyebrow: 'font-sans text-base font-medium italic tracking-[0.14em] text-[#9ab8b5] sm:text-lg',
		title: 'mt-4 text-[clamp(2.4rem,5vw,3.5rem)] font-black leading-tight tracking-[-0.025em] text-[#111111]',
		subtitle: 'mx-auto mt-8 max-w-3xl text-sm font-medium leading-8 tracking-[0.035em] text-[#687174] sm:text-lg',
	},
};

const currentStyles = styles[variant];
---

<div class={currentStyles.container}>
	{eyebrow && <p class={currentStyles.eyebrow}>{eyebrow}</p>}
	{
		currentStyles.headingRow ? (
			<div class={currentStyles.headingRow}>
				<Heading class={currentStyles.title}><slot /></Heading>
				<slot name="action" />
			</div>
		) : (
			<Heading class={currentStyles.title}><slot /></Heading>
		)
	}
	<slot name="lede" />
	{subtitle && <p class={currentStyles.subtitle}>{subtitle}</p>}
</div>
