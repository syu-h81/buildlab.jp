---
import SectionTitle from './SectionTitle.astro';

interface Props {
	eyebrow?: string;
	title?: string;
	description?: string;
	href?: string;
	label?: string;
}

const {
	eyebrow = 'Start a project.',
	title = '想いを、届くかたちへ。',
	description = '新しいWebサイトのこと、今あるサイトの悩み。小さな相談から、一緒に整理していきます。',
	href = 'mailto:info@buildlab.jp',
	label = '相談してみる',
} = Astro.props as Props;
---

<section class="flex items-center border-t border-[#dce5e1] bg-[#fafafa] px-6 py-16 sm:px-10 lg:px-16">
	<div class="mx-auto w-full max-w-6xl text-center">
		<SectionTitle variant="ctaLight" eyebrow={eyebrow} subtitle={description}>
			{title}
		</SectionTitle>

		<a
			href={href}
			class="mt-12 inline-flex min-h-14 min-w-40 items-center justify-center rounded-full bg-[#172b2e] px-10 text-lg font-medium tracking-[0.04em] text-white transition duration-300 hover:-translate-y-1 hover:bg-[#168bff]"
		>
			{label}
		</a>
	</div>
</section>
