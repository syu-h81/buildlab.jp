---
import headerLogo from '../assets/images/header-logo.png';

interface Props {
	theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props as Props;

const navItems = [
	{ label: 'About', href: '/about' },
	{ label: 'Service', href: '/service' },
	{ label: 'Works', href: '/works' },
	{ label: 'Price', href: '/#price' },
	{ label: 'Flow', href: '/flow' },
];
---

<header
	data-site-header
	class:list={[
		'site-header fixed left-0 top-0 z-50 w-full px-5 py-5 sm:px-8 lg:px-12',
		theme === 'light' ? 'theme-light text-[#102231]' : 'text-white',
	]}
>
	<div class="mx-auto flex max-w-[1920px] items-center justify-between gap-8">
		<a href="/" class="block shrink-0" aria-label="BuildLab home">
			<img
				src={headerLogo.src}
				alt="BuildLab"
				class="h-10 w-[120px] object-contain object-left"
				loading="eager"
			/>
		</a>

		<div class="flex items-baseline gap-7 lg:gap-10">
			<nav class="hidden md:block">
				<ul class="flex items-center gap-7 text-[16px] font-bold leading-none tracking-wide md:flex lg:gap-10">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="group relative inline-block pb-3 transition duration-300">
                <span>{item.label}</span>
                <span
                  aria-hidden="true"
                  class="absolute bottom-0 left-0 h-2 w-full origin-left scale-x-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2214%22%20height%3D%228%22%20viewBox%3D%220%200%2014%208%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M1%204C2.5%201%204.5%201%206%204C7.5%207%209.5%207%2013%204%22%20stroke%3D%22%23168bff%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22/%3E%3C/svg%3E')] bg-[length:14px_8px] bg-repeat-x opacity-0 transition duration-300 ease-out group-hover:scale-x-100 group-hover:opacity-100"
                ></span>
              </a>
            </li>
          ))}
        </ul>
			</nav>

			<a
				href="/contact"
				class="inline-flex min-h-10 items-center gap-2 rounded-full bg-[#168bff] px-5 text-sm font-bold leading-none tracking-wide text-white shadow-sm transition duration-300 ease-out hover:bg-white hover:text-black sm:min-h-12 sm:gap-3 sm:px-9 sm:text-[16px]"
			>
				<span>Contact</span>
				<span class="text-2xl leading-none">→</span>
			</a>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const hero = document.querySelector<HTMLElement>('[data-hero-section]');

	const updateHeader = () => {
		if (!header || !hero) return;

		const heroBottom = hero.offsetTop + hero.offsetHeight;
		const triggerPoint = heroBottom - header.offsetHeight;

		header.classList.toggle('is-scrolled', window.scrollY >= triggerPoint);
	};

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });
	window.addEventListener('resize', updateHeader);
</script>

<style>
	.site-header {
		background-color: transparent;
		transition:
			background-color 0.35s ease,
			box-shadow 0.35s ease,
			backdrop-filter 0.35s ease;
	}

	.site-header.is-scrolled {
		background-color: #000000;
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
		color: #ffffff;
		opacity: 0.9;
	}
</style>
